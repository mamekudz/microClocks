{
  "schemaVersion": 1,
  "projectId": "microclocks",
  "source": "..\\..\\..",
  "engine": "auto",
  "timeoutMs": 3600000,
  "features": {
    "git": true,
    "dynamicDisplayName": false,
    "editTargetPaths": true,
    "continueOnError": true,
    "dryRunDefault": true
  },
  "exclusions": {
    "directoryNames": [
      ".cache",
      ".pio",
      "Intermediate",
      "Saved",
      "Binaries",
      "DerivedDataCache"
    ],
    "fileNames": [
      "Thumbs.db",
      ".DS_Store",
      "desktop.ini"
    ],
    "relativePaths": [
      "dist"
    ]
  },
  "targets": [
    {
      "id": "nas-1",
      "label": "NAS 1",
      "path": "Z:\\Projects\\microClocks",
      "selected": true
    }
  ],
  "backup": {
    "mode": "fixed",
    "format": "directory"
  },
  "schedule": {
    "enabled": false,
    "cron": "0 2 * * *",
    "dryRun": true
  }
}
